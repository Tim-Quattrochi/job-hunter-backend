# Neon DB connection string
DATABASE_URL=postgresql://user:password@host:5432/db_name

# Redis URL - use local for development, Upstash for production
# Local (Docker Compose): redis://redis:6379/0
# Production (Upstash): rediss://default:password@your-host.upstash.io:port
REDIS_URL=redis://redis:6379/0

# Stack Auth credentials (obtain from Stack Auth dashboard)
NEXT_PUBLIC_STACK_PROJECT_ID=your_project_id_here
STACK_SECRET_SERVER_KEY=your_secret_key_here

# CORS origins (comma-separated)
CORS_ORIGINS=http://localhost:3000,https://your-app.vercel.app
