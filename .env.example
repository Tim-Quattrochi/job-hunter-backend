# Neon DB connection string
DATABASE_URL=postgresql://user:password@host:5432/db_name

# Redis Configuration
# Development: Use local Docker Redis (docker-compose.yml)
REDIS_URL=redis://redis:6379/0

# Production: Use Upstash Redis (uncomment for production deployment)
# UPSTASH_REDIS_URL=rediss://default:your_password@your-host.upstash.io:6379

# Stack Auth Configuration (obtain from Stack Auth dashboard)
NEXT_PUBLIC_STACK_PROJECT_ID=your_project_id_here
NEXT_PUBLIC_STACK_PUBLISHABLE_CLIENT_KEY=your_publishable_key_here
STACK_SECRET_SERVER_KEY=your_secret_key_here

# CORS Configuration (comma-separated)
CORS_ORIGINS=http://localhost:3000,https://your-app.vercel.app
